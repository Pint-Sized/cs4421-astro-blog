---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import cv from '../data/cv.json';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`CV | ${SITE_TITLE}`}
			description="Review the developer's curriculum vitae, work experience, education, credentials, and skills."
		/>
		<style>
			.cv-section {
				margin-block: 3rem;
			}

			.cv-section > h2 {
				padding-bottom: 0.6rem;
				border-bottom: 1px solid var(--border);
				color: #c8baff;
			}

			.cv-entry {
				margin-block: 1.5rem;
				padding: 1.25rem;
				border-left: 3px solid #9b83ff;
			}

			.cv-entry:nth-of-type(even) {
				border-left-color: #52f2d0;
			}

			.cv-entry h3 {
				color: #f0edff;
			}

			.placeholder-note {
				padding: 1rem;
				border-left: 4px solid #ff69b8;
				color: #d7d2ea;
			}

			.download-link {
				display: inline-block;
				margin-block: 1rem 2rem;
				padding: 0.65rem 1rem;
				border: 1px solid rgba(82, 242, 208, 0.5);
				border-radius: 0.6rem;
				background: linear-gradient(110deg, #6b4eff, #a23fe0);
				color: #fff;
				font-weight: 700;
				text-decoration: none;
				box-shadow: 0 8px 26px rgba(111, 69, 255, 0.3);
			}

			.download-link:hover {
				background: linear-gradient(110deg, #785fff, #ba48ed);
				color: white;
				transform: translateY(-1px);
			}

			@media print {
				:global(body) {
					background: white;
					color: black;
					color-scheme: light;
					font-size: 11pt;
					line-height: 1.4;
				}

				:global(header),
				:global(footer),
				.download-link {
					display: none;
				}

				:global(main) {
					width: auto;
					max-width: none;
					margin: 0;
					padding: 0;
				}

				h1 {
					font-size: 26pt;
				}

				h2 {
					font-size: 17pt;
				}

				h3 {
					font-size: 13pt;
				}

				h1,
				h2,
				h3,
				.cv-section > h2 {
					color: #171522;
				}

				.cv-section {
					margin-block: 1.5rem;
				}

				.cv-entry {
					border-left-color: #5140ad;
					break-inside: avoid;
				}

				:global(.glass-panel) {
					border: 0;
					background: white;
					box-shadow: none;
					backdrop-filter: none;
					-webkit-backdrop-filter: none;
				}

				.placeholder-note {
					border-left: 4px solid #6b4eff;
					color: #29263a;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<p class="placeholder-note glass-panel">{cv.notice}</p>
			<h1>{cv.title}</h1>
			<h2>{cv.name}</h2>
			<p>{cv.contact}</p>
			<a class="download-link" href="/cv.pdf" download="developer-cv.pdf">
				Download current CV as PDF
			</a>

			{cv.sections.map((section, index) => (
				<section class="cv-section" aria-labelledby={`cv-section-${index}`}>
					<h2 id={`cv-section-${index}`}>{section.title}</h2>
					{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
					{section.entries?.map((entry) => (
						<article class="cv-entry glass-panel">
							<h3>{entry.title}</h3>
							<p><strong>{entry.organization}</strong> · {entry.dates}</p>
							<p>{entry.description}</p>
						</article>
					))}
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
