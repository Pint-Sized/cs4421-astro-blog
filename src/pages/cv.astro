---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`CV | ${SITE_TITLE}`}
			description="Review the developer's curriculum vitae, work experience, education, credentials, and skills."
		/>
		<style>
			.cv-section {
				margin-block: 3rem;
			}

			.cv-entry {
				margin-block: 1.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(var(--gray), 25%);
			}

			.cv-entry:last-child {
				border-bottom: 0;
			}

			.placeholder-note {
				padding: 1rem;
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 50%);
			}

			.download-link {
				display: inline-block;
				margin-block: 1rem 2rem;
				padding: 0.65rem 1rem;
				border-radius: 0.4rem;
				background: var(--accent);
				color: white;
				font-weight: 700;
				text-decoration: none;
			}

			.download-link:hover {
				background: var(--accent-dark);
				color: white;
			}

			@media print {
				:global(body) {
					background: white;
					color: black;
					font-size: 11pt;
					line-height: 1.4;
				}

				:global(header),
				:global(footer),
				.download-link {
					display: none;
				}

				:global(main) {
					width: auto;
					max-width: none;
					margin: 0;
					padding: 0;
				}

				h1 {
					font-size: 26pt;
				}

				h2 {
					font-size: 17pt;
				}

				h3 {
					font-size: 13pt;
				}

				.cv-section {
					margin-block: 1.5rem;
				}

				.cv-entry {
					break-inside: avoid;
				}

				.placeholder-note {
					background: white;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<p class="placeholder-note">
				Template content: replace every bracketed prompt with your own accurate details before
				publishing.
			</p>
			<h1>Curriculum vitae</h1>
			<h2>[Your name]</h2>
			<p>[Email address] · [Location] · [Professional profile URL]</p>
			<a class="download-link" href="/cv.pdf" download="developer-cv.pdf">
				Download CV as PDF
			</a>

			<section class="cv-section" aria-labelledby="profile-heading">
				<h2 id="profile-heading">Professional profile</h2>
				<p>
					[Write a short summary of your professional background, strengths, and career goals.]
				</p>
			</section>

			<section class="cv-section" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Work experience</h2>
				<article class="cv-entry">
					<h3>[Role title]</h3>
					<p><strong>[Organization]</strong> · [Start date–End date]</p>
					<p>[Describe your responsibilities, contributions, and measurable achievements.]</p>
				</article>
				<article class="cv-entry">
					<h3>[Role title]</h3>
					<p><strong>[Organization]</strong> · [Start date–End date]</p>
					<p>[Describe your responsibilities, contributions, and measurable achievements.]</p>
				</article>
			</section>

			<section class="cv-section" aria-labelledby="education-heading">
				<h2 id="education-heading">Education and credentials</h2>
				<article class="cv-entry">
					<h3>[Degree or qualification]</h3>
					<p><strong>[Institution]</strong> · [Start date–End date]</p>
					<p>[Add relevant subjects, honors, or other details.]</p>
				</article>
				<article class="cv-entry">
					<h3>[Certification or credential]</h3>
					<p><strong>[Provider]</strong> · [Year]</p>
					<p>[Add relevant details or remove this entry if not applicable.]</p>
				</article>
			</section>

			<section class="cv-section" aria-labelledby="skills-heading">
				<h2 id="skills-heading">Skills</h2>
				<p>
					[List your programming languages, frameworks, tools, and other relevant skills.]
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
