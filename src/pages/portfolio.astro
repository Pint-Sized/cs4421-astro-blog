---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
	{
		id: 'project-one',
		title: 'Project one',
		purpose:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus.',
		contribution:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent commodo cursus magna, vel scelerisque nisl consectetur et.',
		technologies: ['Technology one', 'Technology two'],
		source: 'https://github.com/your-username/project-one',
		demo: 'https://example.com/project-one',
	},
	{
		id: 'project-two',
		title: 'Project two',
		purpose:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas faucibus mollis interdum.',
		contribution:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec ullamcorper nulla non metus auctor fringilla.',
		technologies: ['Technology three', 'Technology four'],
	},
	{
		id: 'project-three',
		title: 'Project three',
		purpose:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras mattis consectetur purus sit amet fermentum.',
		contribution:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean lacinia bibendum nulla sed consectetur.',
		technologies: ['Technology five', 'Technology six'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.project-list {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.project-card {
				display: flex;
				flex-direction: column;
				border: 1px solid rgba(var(--gray), 25%);
				border-radius: 0.75rem;
				padding: 1.5rem;
			}

			.project-card h2 {
				font-size: 1.75rem;
			}

			.project-card h3 {
				margin-top: 0.75rem;
				font-size: 1.1rem;
			}

			.project-card p {
				margin-top: 0;
			}

			.technologies {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				padding: 0;
				list-style: none;
			}

			.technologies li {
				padding: 0.2rem 0.6rem;
				border-radius: 1rem;
				background: rgba(var(--gray-light), 70%);
				font-size: 0.9rem;
			}

			.project-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: auto;
				padding-top: 1rem;
			}

			.no-public-links {
				margin-top: auto !important;
				padding-top: 1rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Portfolio</h1>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Browse selected projects, their
				purpose, and the work involved.
			</p>
			<ul class="project-list">
				{projects.map((project) => (
					<li class="project-card" id={project.id}>
						<h2>{project.title}</h2>
						<h3>Project purpose</h3>
						<p>{project.purpose}</p>
						<h3>My contribution</h3>
						<p>{project.contribution}</p>
						<h3>Technologies used</h3>
						<ul class="technologies">
							{project.technologies.map((technology) => <li>{technology}</li>)}
						</ul>
						{
							project.source || project.demo ? (
								<div class="project-links">
									{project.source && (
										<a href={project.source} target="_blank" rel="noreferrer">
											View source code
										</a>
									)}
									{project.demo && (
										<a href={project.demo} target="_blank" rel="noreferrer">
											View live demo
										</a>
									)}
								</div>
							) : (
								<p class="no-public-links">No public source or demo link is available for this project.</p>
							)
						}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
