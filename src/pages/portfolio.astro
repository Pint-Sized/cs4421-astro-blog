---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const projects = [
	{
		id: 'project-one',
		title: '[Project name]',
		purpose: '[Describe the problem this project solves and who it is for.]',
		contribution: '[Describe your role, work, and notable outcomes.]',
		technologies: ['[Technology]', '[Technology]'],
		source: '',
		demo: '',
	},
	{
		id: 'project-two',
		title: '[Project name]',
		purpose: '[Describe the problem this project solves and who it is for.]',
		contribution: '[Describe your role, work, and notable outcomes.]',
		technologies: ['[Technology]', '[Technology]'],
		source: '',
		demo: '',
	},
	{
		id: 'project-three',
		title: '[Project name]',
		purpose: '[Describe the problem this project solves and who it is for.]',
		contribution: '[Describe your role, work, and notable outcomes.]',
		technologies: ['[Technology]', '[Technology]'],
		source: '',
		demo: '',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Portfolio | ${SITE_TITLE}`}
			description="Browse selected development projects, contributions, technologies, and available demos or source code."
		/>
		<style>
			.project-list {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.project-card {
				display: flex;
				flex-direction: column;
				border: 1px solid rgba(var(--gray), 25%);
				border-radius: 0.75rem;
				padding: 1.5rem;
			}

			.project-card h2 {
				font-size: 1.75rem;
			}

			.project-card h3 {
				margin-top: 0.75rem;
				font-size: 1.1rem;
			}

			.project-card p {
				margin-top: 0;
			}

			.technologies {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				padding: 0;
				list-style: none;
			}

			.technologies li {
				padding: 0.2rem 0.6rem;
				border-radius: 1rem;
				background: rgba(var(--gray-light), 70%);
				font-size: 0.9rem;
			}

			.project-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: auto;
				padding-top: 1rem;
			}

			.no-public-links {
				margin-top: auto !important;
				padding-top: 1rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<h1>Portfolio</h1>
			<p>
				[Introduce your selected projects and the kinds of problems you enjoy solving.]
			</p>
			<ul class="project-list">
				{projects.map((project) => (
					<li class="project-card" id={project.id}>
						<h2>{project.title}</h2>
						<h3>Project purpose</h3>
						<p>{project.purpose}</p>
						<h3>My contribution</h3>
						<p>{project.contribution}</p>
						<h3>Technologies used</h3>
						<ul class="technologies">
							{project.technologies.map((technology) => <li>{technology}</li>)}
						</ul>
						{
							project.source || project.demo ? (
								<div class="project-links">
									{project.source && (
										<a href={project.source} target="_blank" rel="noreferrer">
											View source code
										</a>
									)}
									{project.demo && (
										<a href={project.demo} target="_blank" rel="noreferrer">
											View live demo
										</a>
									)}
								</div>
							) : (
								<p class="no-public-links">
									[Add public source or demo links when available, or replace this note.]
								</p>
							)
						}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
