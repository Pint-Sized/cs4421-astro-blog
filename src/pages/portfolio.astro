---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Keep project summaries in page data so each card uses one consistent template.
const projects = [
	{
		id: 'nixos-dotfiles',
		title: 'NixOS Dotfiles',
		purpose:
			'A reproducible, modular configuration for setting up personalized NixOS desktop and laptop environments.',
		contribution:
			'I maintain the Nix flake and reusable system and Home Manager modules, organizing configuration for host setups, desktop workflows, and everyday development tools.',
		technologies: ['Nix', 'NixOS', 'Home Manager', 'Hyprland'],
		image: '/portfolio/nixos-dotfiles.svg',
		imageAlt: 'Illustration of a laptop and modular NixOS system and Home Manager configurations.',
		source: 'https://github.com/Pint-Sized/.dotfiles',
		demo: '',
	},
	{
		id: 'system-fetch',
		title: 'System Fetch',
		purpose:
			'A Linux command-line tool for inspecting processor, memory, PCI, and USB information in a terminal.',
		contribution:
			'I built the system information collector and a tabbed terminal interface with periodic refreshes. The tool also supports plain-text reports and structured JSON export.',
		technologies: ['Java 21', 'Maven', 'TUI4J', 'Linux'],
		image: '/portfolio/system-fetch.svg',
		imageAlt: 'System Fetch terminal interface showing processor information and tab navigation with representative sample data.',
		source: 'https://github.com/Pint-Sized/CS4421SystemInfo',
		demo: '',
	},
	{
		id: 'chevron',
		title: 'Chevron — Customized Fork',
		purpose:
			'A customizable browser start page for quick access to search and frequently used content.',
		contribution:
			'I customized this open-source React project by removing its ChatGPT integration and improving its color-scheme settings.',
		technologies: ['JavaScript', 'React', 'Vite'],
		image: '/portfolio/chevron-startpage.svg',
		imageAlt: 'Illustration of a dark browser start page with a search field and shortcut tiles; not an application screenshot.',
		source: 'https://github.com/Pint-Sized/chevron',
		demo: '',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Portfolio | ${SITE_TITLE}`}
			description="Browse selected development projects, contributions, technologies, and available demos or source code."
		/>
		<style>
			/* Arrange project cards to adapt from one column to a wider grid. */
			.project-list {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
				list-style: none;
				padding: 0;
			}

			/* Keep each project description and its available links together. */
			.project-card {
				display: flex;
				flex-direction: column;
				padding: 1.5rem;
				border-top: 2px solid #9b83ff;
				transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
			}

			.project-card:nth-child(3n + 2) {
				border-top-color: #52f2d0;
			}

			.project-card:nth-child(3n) {
				border-top-color: #ff69b8;
			}

			.project-card:hover {
				transform: translateY(-4px);
				border-color: rgba(82, 242, 208, 0.62);
				box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42), 0 0 28px rgba(141, 123, 255, 0.1);
			}

			.project-card h2 {
				font-size: 1.75rem;
				color: #f5f2ff;
			}

			.project-image {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				margin-bottom: 1.25rem;
				border: 1px solid var(--border);
				border-radius: 0.75rem;
				object-fit: cover;
			}

			.project-card h3 {
				margin-top: 0.75rem;
				font-size: 1.1rem;
				color: #bdb1ff;
			}

			.project-card p {
				margin-top: 0;
			}

			/* Use compact chips to make each project's stack easy to scan. */
			.technologies {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				padding: 0;
				list-style: none;
			}

			.technologies li {
				padding: 0.2rem 0.6rem;
				border: 1px solid rgba(82, 242, 208, 0.24);
				border-radius: 1rem;
				background: rgba(82, 242, 208, 0.08);
				color: #8cf6df;
				font-size: 0.9rem;
			}

			.project-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: auto;
				padding-top: 1rem;
			}

			.no-public-links {
				margin-top: auto !important;
				padding-top: 1rem;
				color: #aaa6c1;
				font-size: 0.95rem;
			}

			@media (prefers-reduced-motion: reduce) {
				.project-card {
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<h1>Portfolio</h1>
			<p>
				A selection of my projects, from reproducible Linux configurations and system tools to
				customizations of an open-source browser start page.
			</p>
			<!-- Render project purpose, contribution, technologies, and optional public links. -->
			<ul class="project-list">
				{projects.map((project) => (
					<li class="project-card glass-panel" id={project.id}>
						<img
							class="project-image"
							src={project.image}
							alt={project.imageAlt}
							width="1048"
							height="577"
							loading="lazy"
							decoding="async"
						/>
						<h2>{project.title}</h2>
						<h3>Project purpose</h3>
						<p>{project.purpose}</p>
						<h3>My contribution</h3>
						<p>{project.contribution}</p>
						<h3>Technologies used</h3>
						<ul class="technologies">
							{project.technologies.map((technology) => <li>{technology}</li>)}
						</ul>
						{
							project.source || project.demo ? (
								<div class="project-links">
									{project.source && (
										<a href={project.source} target="_blank" rel="noopener noreferrer">
											View source code
										</a>
									)}
									{project.demo && (
										<a href={project.demo} target="_blank" rel="noopener noreferrer">
											View live demo
										</a>
									)}
								</div>
							) : (
								<p class="no-public-links">
									[Add public source or demo links when available, or replace this note.]
								</p>
							)
						}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
