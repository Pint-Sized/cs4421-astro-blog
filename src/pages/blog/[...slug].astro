---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const post = Astro.params.slug ? await getEntry('blog', Astro.params.slug) : undefined;
if (!post) Astro.response.status = 404;
const Content = post ? (await render(post)).Content : undefined;
---

{
	post && Content ? (
		<BlogPost {...post.data}>
			<Content />
		</BlogPost>
	) : (
		<main><h1>Post not found</h1></main>
	)
}
