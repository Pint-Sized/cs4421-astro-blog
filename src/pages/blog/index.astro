---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description="Read recent development articles, project notes, and technical writing."
		/>
		<style>
			/* Give the blog index room for a featured first post and a responsive card grid. */
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			/* Style the first item as a featured post and later items as compact cards. */
			ul li {
				width: calc(50% - 1rem);
				padding: 1rem;
				border: 1px solid var(--border);
				border-top: 2px solid #9b83ff;
				border-radius: 1rem;
				background: linear-gradient(145deg, rgba(33, 30, 51, 0.96), rgba(20, 19, 31, 0.96));
				box-shadow: var(--box-shadow);
				transition: transform 160ms ease, box-shadow 160ms ease;
			}

			/* Add varied accent colors without changing the shared card structure. */
			ul li:nth-child(3n + 2) {
				border-top-color: #52f2d0;
			}

			ul li:nth-child(3n) {
				border-top-color: #ff69b8;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
				padding: 1.5rem;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			/* Keep post titles and dates readable on the dark surfaces. */
			.title {
				margin: 0;
				color: #f5f2ff;
				line-height: 1;
			}
			.date {
				margin: 0;
				color: #aaa6c1;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}

			ul li:hover {
				transform: translateY(-2px);
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 24px rgba(141, 123, 255, 0.12);
			}
			/* Collapse cards to one column on smaller screens. */
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				ul li {
					transition: none;
					transform: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<!-- Present posts in reverse chronological order from the blog collection. -->
			<section aria-labelledby="blog-heading">
				<h1 id="blog-heading">Blog</h1>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h2 class="title">{post.data.title}</h2>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
