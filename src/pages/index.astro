---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description="Explore a developer profile, experience, portfolio, CV, and recent blog posts."
		/>
		<style>
			.intro,
			.experience,
			.career-links,
			.recent-posts {
				margin-block: 4rem;
			}

			.intro {
				position: relative;
				margin-top: 2rem;
				padding: clamp(2rem, 8vw, 5rem);
				overflow: hidden;
				border: 1px solid rgba(141, 123, 255, 0.3);
				border-radius: 1.5rem;
				background:
					radial-gradient(ellipse at 86% 22%, rgba(0, 221, 193, 0.13), transparent 22rem),
					radial-gradient(ellipse at 12% 100%, rgba(197, 50, 255, 0.17), transparent 28rem),
					linear-gradient(130deg, rgba(28, 24, 48, 0.97), rgba(17, 16, 27, 0.94));
				box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38), inset 0 1px rgba(255, 255, 255, 0.06);
			}

			.intro::after {
				position: absolute;
				right: -2rem;
				bottom: -5rem;
				width: 16rem;
				height: 16rem;
				border: 1px solid rgba(82, 242, 208, 0.18);
				border-radius: 50%;
				box-shadow: 0 0 0 2rem rgba(82, 242, 208, 0.025), 0 0 0 4rem rgba(141, 123, 255, 0.025);
				content: '';
				pointer-events: none;
			}

			.intro h1 {
				position: relative;
				z-index: 1;
				max-width: 13ch;
				font-size: clamp(2.8rem, 8vw, 5.5rem);
				background: linear-gradient(100deg, #fff 5%, #b8aaff 52%, #52f2d0 100%);
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.intro p {
				position: relative;
				z-index: 1;
				max-width: 54rem;
				color: #c3bfd5;
			}

			.intro p:last-child {
				margin-top: 1.75rem;
			}

			.intro p:last-child a {
				display: inline-flex;
				align-items: center;
				padding: 0.7rem 1.1rem;
				border: 1px solid rgba(82, 242, 208, 0.55);
				border-radius: 0.65rem;
				background: rgba(82, 242, 208, 0.1);
				color: #72f5d9;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
			}

			.intro p:last-child a:hover {
				background: rgba(82, 242, 208, 0.2);
				box-shadow: 0 0 28px rgba(82, 242, 208, 0.15);
			}

			.experience h2,
			.career-links h2,
			.recent-posts h2 {
				padding-left: 1rem;
				border-left: 3px solid var(--accent);
			}

			.experience-grid,
			.career-links ul {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.experience-card,
			.career-links li {
				padding: 1.25rem;
			}

			.experience-card p:last-child {
				margin-bottom: 0;
			}

			.experience-card,
			.career-links li,
			.recent-posts li {
				border-top: 2px solid rgba(141, 123, 255, 0.7);
			}

			.experience-card:nth-child(even),
			.career-links li:nth-child(2),
			.recent-posts li:nth-child(3n + 2) {
				border-top-color: rgba(82, 242, 208, 0.8);
			}

			.career-links li:nth-child(3),
			.recent-posts li:nth-child(3n) {
				border-top-color: rgba(255, 105, 184, 0.8);
			}

			.career-links a {
				font-weight: 700;
			}

			.career-links h3 a,
			.recent-posts li a {
				color: #f0edff;
				text-decoration: none;
			}

			.career-links li p,
			.recent-posts li time {
				color: #aaa6c1;
			}

			.recent-posts ul {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.recent-posts li {
				padding: 1.25rem;
			}

			.recent-posts li a {
				text-decoration: none;
			}

			.recent-posts li a:hover h3 {
				color: var(--accent);
			}

			.recent-posts li:hover,
			.experience-card:hover,
			.career-links li:hover {
				transform: translateY(-3px);
				border-color: rgba(82, 242, 208, 0.55);
				box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42), 0 0 24px rgba(82, 242, 208, 0.07);
			}

			.recent-posts time {
				font-size: 0.9rem;
			}

			@media (prefers-reduced-motion: reduce) {
				.recent-posts li:hover,
				.experience-card:hover,
				.career-links li:hover {
					transform: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<section class="intro" aria-labelledby="intro-heading">
				<h1 id="intro-heading">[Your name]</h1>
				<p>
					[Your professional title or focus] — [Write a concise introduction about your experience
					and the kind of development work you do.]
				</p>
				<p><a href="#experience">Explore my experience</a></p>
			</section>

			<section class="experience" id="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Experience and credentials</h2>
				<p>
					[Summarize your professional background, education, and most relevant credentials.]
				</p>
				<div class="experience-grid">
					<article class="experience-card glass-panel">
						<h3>[Your role]</h3>
						<p><strong>[Organization]</strong> · [Start year–End year]</p>
						<p>[Describe your responsibilities and achievements.]</p>
					</article>
					<article class="experience-card glass-panel">
						<h3>[Qualification or credential]</h3>
						<p><strong>[Institution or provider]</strong> · [Year]</p>
						<p>[Add relevant details about this qualification or credential.]</p>
					</article>
				</div>
			</section>

			<section class="career-links" aria-labelledby="career-links-heading">
				<h2 id="career-links-heading">Explore my work</h2>
				<p>
					[Add a short introduction to your CV, portfolio, and writing.]
				</p>
				<ul>
					<li class="glass-panel">
						<h3><a href="/cv">CV</a></h3>
						<p>[Briefly describe what visitors can find in your CV.]</p>
					</li>
					<li class="glass-panel">
						<h3><a href="/portfolio">Portfolio</a></h3>
						<p>[Briefly describe the projects featured in your portfolio.]</p>
					</li>
					<li class="glass-panel">
						<h3><a href="/blog/">Blog</a></h3>
						<p>[Briefly describe the topics you write about.]</p>
					</li>
				</ul>
			</section>

			<section class="recent-posts" aria-labelledby="recent-posts-heading">
				<h2 id="recent-posts-heading">Recent posts</h2>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Browse recent writing and
					projects.
				</p>
				<ul>
					{recentPosts.map((post) => (
						<li class="glass-panel">
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<FormattedDate date={post.data.pubDate} />
							</a>
						</li>
					))}
				</ul>
				<p><a href="/blog/">View all posts</a></p>
				<p><a href="/rss.xml">Subscribe via RSS</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
