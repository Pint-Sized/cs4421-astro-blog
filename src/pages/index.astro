---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro,
			.experience,
			.career-links,
			.recent-posts {
				margin-block: 4rem;
			}

			.experience-grid,
			.career-links ul {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.experience-card,
			.career-links li {
				border: 1px solid rgba(var(--gray), 25%);
				border-radius: 0.75rem;
				padding: 1.25rem;
			}

			.experience-card p:last-child {
				margin-bottom: 0;
			}

			.career-links a {
				font-weight: 700;
			}

			.recent-posts ul {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
				list-style: none;
				padding: 0;
			}

			.recent-posts li {
				border: 1px solid rgba(var(--gray), 25%);
				border-radius: 0.75rem;
				padding: 1.25rem;
			}

			.recent-posts li a {
				color: var(--black);
				text-decoration: none;
			}

			.recent-posts li a:hover h3 {
				color: var(--accent);
			}

			.recent-posts time {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="intro-heading">
				<h1 id="intro-heading">Developer profile</h1>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean eu leo quam. Pellentesque
					ornare sem lacinia quam venenatis vestibulum.
				</p>
				<p><a href="#experience">Explore my experience</a></p>
			</section>

			<section class="experience" id="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Experience and credentials</h2>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Replace these sample entries
					with your career history and qualifications.
				</p>
				<div class="experience-grid">
					<article class="experience-card">
						<h3>Example role</h3>
						<p><strong>Example organization</strong> · 20XX–Present</p>
						<p>
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent commodo cursus
							magna, vel scelerisque nisl consectetur et.
						</p>
					</article>
					<article class="experience-card">
						<h3>Example qualification</h3>
						<p><strong>Example institution</strong> · 20XX</p>
						<p>
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras mattis consectetur
							purus sit amet fermentum.
						</p>
					</article>
				</div>
			</section>

			<section class="career-links" aria-labelledby="career-links-heading">
				<h2 id="career-links-heading">Explore my work</h2>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Find more information in the
					sections below.
				</p>
				<ul>
					<li>
						<h3><a href="/cv">CV</a></h3>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
					</li>
					<li>
						<h3><a href="/portfolio">Portfolio</a></h3>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
					</li>
					<li>
						<h3><a href="/blog/">Blog</a></h3>
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
					</li>
				</ul>
			</section>

			<section class="recent-posts" aria-labelledby="recent-posts-heading">
				<h2 id="recent-posts-heading">Recent posts</h2>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Browse recent writing and
					projects.
				</p>
				<ul>
					{recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<FormattedDate date={post.data.pubDate} />
							</a>
						</li>
					))}
				</ul>
				<p><a href="/blog/">View all posts</a></p>
				<p><a href="/rss.xml">Subscribe via RSS</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
