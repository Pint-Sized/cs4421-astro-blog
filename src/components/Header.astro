---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header>
	<div class="header-content">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<nav class="internal-links" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#experience">Experience</HeaderLink>
			<HeaderLink href="/cv">CV</HeaderLink>
			<HeaderLink href="/portfolio">Portfolio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</nav>
		<nav class="social-links" aria-label="Social media">
			<a href="https://github.com/Pint-Sized" target="_blank" rel="noopener noreferrer">
				GitHub
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
			<a href="https://www.instagram.com/fionn.bennett/" target="_blank" rel="noopener noreferrer">
				Instagram
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</nav>
	</div>
</header>
<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 1;
		padding: 0.5rem 0.75rem;
		transform: translateY(-150%);
		border-radius: 0.25rem;
		background: white;
		color: rgb(var(--black));
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.site-title {
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
	}

	.header-content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
	}

	.header-content a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	.header-content a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	@media (max-width: 720px) {
		.header-content {
			align-items: flex-start;
			flex-direction: column;
		}

		.internal-links {
			margin-inline: -0.5rem;
		}
	}
</style>
