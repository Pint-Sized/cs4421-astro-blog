---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header>
	<div class="header-content">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<nav class="internal-links" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#experience">Experience</HeaderLink>
			<HeaderLink href="/cv">CV</HeaderLink>
			<HeaderLink href="/portfolio">Portfolio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</nav>
		<nav class="social-links" aria-label="Social media">
			<a href="https://github.com/Pint-Sized" target="_blank" rel="noopener noreferrer">
				GitHub
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
			<a href="https://www.instagram.com/fionn.bennett/" target="_blank" rel="noopener noreferrer">
				Instagram
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</nav>
	</div>
</header>
<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 1;
		padding: 0.5rem 0.75rem;
		transform: translateY(-150%);
		border-radius: 0.5rem;
		background: #171522;
		color: #fff;
		box-shadow: var(--box-shadow);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		border-bottom: 1px solid rgba(185, 176, 255, 0.16);
		background: rgba(12, 11, 18, 0.88);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.24);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.header-content {
		max-width: 1440px;
		margin-inline: auto;
	}

	.site-title {
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		background: linear-gradient(100deg, #52f2d0, #9b83ff 78%);
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.header-content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
	}

	.header-content a {
		margin-block: 0.4rem;
		padding: 0.55rem 0.75rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		color: #d3d0e2;
		text-decoration: none;
	}

	.header-content a:hover {
		border-color: rgba(82, 242, 208, 0.28);
		background: rgba(82, 242, 208, 0.08);
		color: var(--accent);
	}

	.header-content a.active {
		border-color: rgba(141, 123, 255, 0.36);
		background: rgba(141, 123, 255, 0.13);
		color: #c3b9ff;
	}

	@media (max-width: 720px) {
		.header-content {
			align-items: flex-start;
			flex-direction: column;
		}

		.internal-links {
			margin-inline: -0.75rem;
		}

		.social-links {
			margin-inline: -0.75rem;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		header {
			background: #0c0b12;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}
</style>
