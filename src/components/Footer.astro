---
const today = new Date();
---

<!-- Keep the copyright year current without requiring annual edits. -->
<footer>
	&copy; {today.getFullYear()} [Your name]. All rights reserved.
</footer>
<style>
	footer {
		margin-top: 2rem;
		padding: 2em 1em 3em;
		border-top: 1px solid var(--border);
		background: linear-gradient(90deg, rgba(141, 123, 255, 0.08), rgba(82, 242, 208, 0.05));
		color: rgb(var(--gray-dark));
		text-align: center;
	}

	@media (prefers-reduced-transparency: reduce) {
		footer {
			background: #11101a;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}
</style>
